<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Shield Glow Arc -->
    <path
        android:strokeWidth="2.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 33,36 C 33,36 54,26 54,26 C 54,26 75,36 75,36 C 75,58 64,72 54,80 C 44,72 33,58 33,36 Z" />

    <!-- Privacy Shield Inner Body with Gradient -->
    <path
        android:pathData="M 36,38 C 36,38 54,29 54,29 C 54,29 72,38 72,38 C 72,57 62,69 54,76 C 46,69 36,57 36,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="29"
                android:endX="72"
                android:endY="76"
                android:type="linear">
                <item android:color="#0284C7" android:offset="0.0" />
                <item android:color="#0369A1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized 'N' Monogram / Compass Blade -->
    <!-- Left vertical bar of N -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 44,42 L 48,42 L 48,64 L 44,64 Z" />

    <!-- Right vertical bar of N -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 60,42 L 64,42 L 64,64 L 60,64 Z" />

    <!-- Diagonal cross beam of N forming dynamic arrow / compass -->
    <path
        android:pathData="M 45,43 L 63,63 L 59,65 L 43,45 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="42"
                android:endX="64"
                android:endY="64"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#F0F9FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Navigation Compass Core Dot -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M 54,50 A 3,3 0 1,1 53.9,50 Z" />

    <!-- Speed / Freedom Orbit Wing -->
    <path
        android:strokeWidth="1.8"
        android:strokeColor="#7DD3FC"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 28,52 C 28,68 40,78 54,78 C 68,78 80,68 80,52" />
</vector>
